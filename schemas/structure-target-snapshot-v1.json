{
  "$defs": {
    "StructureLeg": {
      "additionalProperties": false,
      "properties": {
        "instrument": {
          "minLength": 1,
          "title": "Instrument",
          "type": "string"
        },
        "ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ratio"
        }
      },
      "required": [
        "instrument",
        "ratio"
      ],
      "title": "StructureLeg",
      "type": "object"
    },
    "StructureSnapshotData": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "book_id": {
          "default": "main",
          "minLength": 1,
          "title": "Book Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sizing_basis": {
          "const": "strategy_budget_risk",
          "default": "strategy_budget_risk",
          "title": "Sizing Basis",
          "type": "string"
        },
        "strategy_id": {
          "minLength": 1,
          "title": "Strategy Id",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/StructureTarget"
          },
          "title": "Targets",
          "type": "array"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "strategy_id",
        "revision",
        "as_of",
        "targets"
      ],
      "title": "StructureSnapshotData",
      "type": "object"
    },
    "StructureTarget": {
      "additionalProperties": false,
      "properties": {
        "legs": {
          "items": {
            "$ref": "#/$defs/StructureLeg"
          },
          "minItems": 2,
          "title": "Legs",
          "type": "array"
        },
        "structure_id": {
          "minLength": 1,
          "title": "Structure Id",
          "type": "string"
        },
        "target_risk_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Target Risk Fraction"
        }
      },
      "required": [
        "structure_id",
        "legs",
        "target_risk_fraction"
      ],
      "title": "StructureTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/StructureSnapshotData"
    },
    "dataschema": {
      "const": "urn:defacto:conductor:schema:structure-target-snapshot:v1",
      "default": "urn:defacto:conductor:schema:structure-target-snapshot:v1",
      "title": "Dataschema",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "specversion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Specversion",
      "type": "string"
    },
    "subject": {
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "title": "Time",
      "type": "string"
    },
    "type": {
      "const": "com.defacto.conductor.structure-target-snapshot.v1",
      "default": "com.defacto.conductor.structure-target-snapshot.v1",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source",
    "subject",
    "time",
    "data"
  ],
  "title": "StructureTargetSnapshot",
  "type": "object"
}
